rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidLabel(data) {
      return data.codigo is string && data.codigo.size() <= 64 &&
             data.descricao is string && data.descricao.size() <= 256 &&
             data.quantidade is string && data.quantidade.size() <= 32 &&
             data.validade is string && data.validade.size() <= 32;
    }

    // Connectivity verification probe
    match /test/{docId} {
      allow read: if true;
    }

    // Box labels collection
    match /labels/{labelId} {
      allow read: if true;
      allow create, update: if isValidId(labelId) && isValidLabel(incoming());
      allow delete: if isValidId(labelId);
    }
  }
}
